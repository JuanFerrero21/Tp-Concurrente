@startuml
title Despertar de un hilo y reingreso preferente al monitor

skinparam backgroundColor white
skinparam ActorBorderColor #A80036
skinparam ActorFontColor black
skinparam ActorBackgroundColor #FEFECE
skinparam ParticipantBorderColor #A80036
skinparam ParticipantBackgroundColor white
skinparam ParticipantFontColor black
skinparam LifeLineBorderColor #A80036
skinparam LifeLineBackgroundColor #A80036
skinparam ArrowColor #A80036
skinparam ArrowFontColor black
skinparam SequenceGroupBorderColor #A80036
skinparam SequenceGroupBackgroundColor white
skinparam SequenceGroupFontColor black
skinparam NoteBackgroundColor #FBFB77
skinparam NoteBorderColor #A80036
skinparam NoteFontColor black

actor "hilo A : Hilo" as HiloA
actor "hilo B : Hilo" as HiloB

participant "monitor : Monitor" as Monitor
participant "colasTransiciones : ColasTransiciones" as Colas
participant "semaforoTi : Semaphore" as SemaforoTi
participant "mutex : Mutex" as Mutex
participant "redDePetri : RedDePetri" as Red

== Hilo A queda dormido en la cola de Ti ==

HiloA -> Monitor : fireTransition(Ti)
activate Monitor
Monitor -> Mutex : acquire()
activate Mutex
Mutex --> Monitor : mutex adquirido
deactivate Mutex

Monitor -> Red : puedeDisparar(Ti)
Red --> Monitor : false

Monitor -> Colas : esperar(Ti)
activate Colas
Colas -> Colas : bloqueadosPorTransicion[Ti]++
Colas -> Mutex : release()
activate Mutex
Mutex --> Colas : mutex liberado
deactivate Mutex

Colas -> SemaforoTi : acquire()
activate SemaforoTi

note right of Colas
El hilo A queda bloqueado en el semaforo
de Ti y no retiene el mutex del monitor.
end note

... mientras A duerme, otro hilo puede entrar al monitor ...

== Hilo B dispara y la politica elige despertar Ti ==

HiloB -> Monitor : fireTransition(Tj)
activate Monitor
Monitor -> Mutex : acquire()
activate Mutex
Mutex --> Monitor : mutex adquirido
deactivate Mutex

Monitor -> Red : puedeDisparar(Tj)
Red --> Monitor : true
Monitor -> Red : disparar(Tj)
Red --> Monitor : true

Monitor -> Monitor : despertarTransicionElegidaPorPolitica()
Monitor -> Colas : despertar(Ti)
activate Colas

Colas -> Colas : controlColas.acquire()

alt permisosPendientes[Ti] < bloqueadosPorTransicion[Ti]
    Colas -> Colas : permisosPendientes[Ti]++
    Colas -> Mutex : registrarReingresoPreferente()
    activate Mutex
    Mutex --> Colas : preferente pendiente registrado
    deactivate Mutex
    Colas -> SemaforoTi : release()
    SemaforoTi --> Colas : permiso liberado

    note right of Colas
    Se libera un solo permiso porque hay
    un hilo realmente bloqueado en Ti y
    todavia no tenia permiso pendiente.
    end note
else no hay bloqueado sin permiso
    note right of Colas
    No se libera nada para evitar dejar
    permisos sobrantes en el semaforo.
    end note
end

Colas -> Colas : controlColas.release()
Colas --> Monitor : retorno
deactivate Colas

Monitor -> Mutex : release()
activate Mutex
Mutex --> Monitor : mutex liberado
deactivate Mutex
Monitor --> HiloB : true
deactivate Monitor

== Hilo A despierta y recupera el mutex ==

SemaforoTi --> Colas : acquire() retorna
deactivate SemaforoTi

Colas -> Colas : controlColas.acquire()
Colas -> Colas : bloqueadosPorTransicion[Ti]--
Colas -> Colas : permisosPendientes[Ti]--
Colas -> Colas : controlColas.release()

Colas -> Mutex : adquirirComoPreferente()
activate Mutex
Mutex --> Colas : mutex adquirido con prioridad
deactivate Mutex

Colas --> Monitor : vuelve desde esperar(Ti)
deactivate Colas

note right of Mutex
El hilo A no vuelve como un hilo normal.
Como la politica lo desperto, reingresa
por adquirirComoPreferente(). Los hilos
nuevos que llaman acquire() ceden mientras
haya reingresos preferentes pendientes.
end note

== Hilo A reintenta dentro del while ==

Monitor -> Red : simulacionFinalizada()
Red --> Monitor : false
Monitor -> Red : puedeDispararPorEstadoSimulacion(Ti)
Red --> Monitor : true
Monitor -> Red : puedeDisparar(Ti)
Red --> Monitor : true

note right of Monitor
La senial no dispara Ti automaticamente.
Solo despierta al hilo. Al volver al
monitor, el hilo reevalua las condiciones.
end note

Monitor -> Colas : terminarEspera(Ti)
Monitor -> Red : disparar(Ti)
Red --> Monitor : true
Monitor -> Mutex : release()
activate Mutex
Mutex --> Monitor : mutex liberado
deactivate Mutex
Monitor --> HiloA : true
deactivate Monitor

@enduml
