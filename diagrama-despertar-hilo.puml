@startuml

title Despertar por politica y transferencia directa del monitor

skinparam backgroundColor white
skinparam ActorBorderColor #A80036
skinparam ActorFontColor black
skinparam ActorBackgroundColor #FEFECE
skinparam ParticipantBorderColor #A80036
skinparam ParticipantBackgroundColor white
skinparam ParticipantFontColor black
skinparam LifeLineBorderColor #A80036
skinparam LifeLineBackgroundColor #A80036
skinparam ArrowColor #A80036
skinparam ArrowFontColor black
skinparam SequenceGroupBorderColor #A80036
skinparam SequenceGroupBackgroundColor white
skinparam SequenceGroupFontColor black
skinparam NoteBackgroundColor #FBFB77
skinparam NoteBorderColor #A80036
skinparam NoteFontColor black

actor "hilo A : Hilo" as HiloA
actor "hilo B : Hilo" as HiloB

participant "monitor : Monitor" as Monitor
participant "mutex : Mutex" as Mutex
participant "colasTransiciones : ColasTransiciones" as Colas
participant "colas[Ti] : Semaphore" as SemaforoTi
participant "redDePetri : RedDePetri" as Red
participant "politica : Politica" as Politica

== Hilo A intenta Ti y debe esperar ==

HiloA -> Monitor : fireTransition(Ti)
activate Monitor

Monitor -> Mutex : acquire()
activate Mutex
Mutex --> Monitor : permiso adquirido
deactivate Mutex

Monitor -> Red : simulacionFinalizada()
Red --> Monitor : false

Monitor -> Red : puedeDispararPorEstadoSimulacion(Ti)
Red --> Monitor : true

Monitor -> Red : puedeDisparar(Ti)
Red --> Monitor : false

Monitor -> Red : estaAntesDeLaVentanaTemporal(Ti)
Red --> Monitor : false

Monitor -> Colas : esperar(Ti)
activate Colas

Colas -> Colas : esperando[Ti]++

note right of Colas
"esperando[]" es el unico contador.
No hay un segundo contador aparte
para "quiere disparar" vs "esta bloqueado":
se incrementa recien aca, justo antes
de bloquearse de verdad.
end note

Colas -> Mutex : release()
activate Mutex
Mutex --> Colas : permiso liberado
deactivate Mutex

Colas -> SemaforoTi : acquireUninterruptibly()
activate SemaforoTi

note right of SemaforoTi
colas[Ti] empieza con 0 permisos.
Por eso A queda bloqueado hasta que
alguien haga release() sobre esta cola.
end note

note right of Mutex
A NO conserva el mutex mientras espera.

Esto permite que otro hilo pueda
entrar al monitor y modificar el estado.
end note

deactivate Monitor

... A permanece bloqueado mientras otro hilo puede avanzar ...

== Hilo B entra y dispara Tj ==

HiloB -> Monitor : fireTransition(Tj)
activate Monitor

Monitor -> Mutex : acquire()
activate Mutex
Mutex --> Monitor : permiso adquirido
deactivate Mutex

Monitor -> Red : simulacionFinalizada()
Red --> Monitor : false

Monitor -> Red : puedeDispararPorEstadoSimulacion(Tj)
Red --> Monitor : true

Monitor -> Red : puedeDisparar(Tj)
Red --> Monitor : true

Monitor -> Red : disparar(Tj)
activate Red
Red --> Monitor : true
deactivate Red

== Politica selecciona Ti ==

Monitor -> Red : simulacionFinalizada()
Red --> Monitor : false

Monitor -> Monitor : despertarTransicionElegidaPorPolitica()

Monitor -> Red : obtenerTransicionesDisparables()
Red --> Monitor : candidatas disparables

Monitor -> Colas : tieneHiloEsperando(Ti)
Colas --> Monitor : true

Monitor -> Red : puedeDispararPorEstadoSimulacion(Ti)
Red --> Monitor : true

note right of Monitor
Ti entra al conjunto de candidatas solo
si esta disparable AHORA y tiene a alguien
dormido en su cola. Se recalcula de cero
despues de cada disparo, bajo el mutex,
asi que nunca queda una foto vieja.
end note

Monitor -> Politica : elegirTransicion(candidatas)
activate Politica
Politica --> Monitor : Ti
deactivate Politica

Monitor -> Colas : despertar(Ti)
activate Colas

Colas -> Colas : esperando[Ti] > 0 ?
Colas -> Colas : esperando[Ti]--
Colas -> SemaforoTi : release()

Colas --> Monitor : true
deactivate Colas

note right of Colas
Se libera UN solo permiso.
No hay un contador aparte de "handoff":
en regimen normal (finalizando == false)
este es el unico lugar que hace
release() sobre colas[Ti], asi que el
unico que puede despertarse es A.
end note

Monitor -> Monitor : liberarMutex = false

note right of Monitor
Como despertar(Ti) devolvio true,
el hilo B NO debe hacer mutex.release().
end note

Monitor --> HiloB : true
deactivate Monitor

== Hilo A hereda el monitor sin pedirlo ==

SemaforoTi --> Colas : acquireUninterruptibly() retorna
deactivate SemaforoTi

activate Colas

Colas -> Colas : finalizando ?

alt finalizando == false (caso normal)

    note right of Colas
    A NO ejecuta mutex.acquire().

    B nunca solto el mutex real (quedo con
    liberarMutex = false), asi que A lo
    hereda gratis: nadie mas pudo haberlo
    tomado en el medio.
    end note

else finalizando == true (se esta cerrando la simulacion)

    Colas -> Mutex : acquire()
    activate Mutex
    Mutex --> Colas : permiso adquirido
    deactivate Mutex

    note right of Colas
    despertarTodos() pudo haber despertado
    a varios hilos de una. Ya no hay "un"
    sucesor al que transferirle el control,
    asi que cada uno compite por el mutex
    de la forma normal.
    end note

end

Colas --> Monitor : retorna de esperar(Ti)
deactivate Colas

activate Monitor

== A vuelve al while de fireTransition(Ti) ==

Monitor -> Red : simulacionFinalizada()
Red --> Monitor : false

Monitor -> Red : puedeDispararPorEstadoSimulacion(Ti)
Red --> Monitor : true

Monitor -> Red : puedeDisparar(Ti)
Red --> Monitor : true

note right of Monitor
Despertar a A NO dispara Ti automaticamente.

A vuelve al while y reevalua
todas las condiciones desde cero.
end note

Monitor -> Red : disparar(Ti)
activate Red
Red --> Monitor : true
deactivate Red

note right of Monitor
Despues del disparo de Ti vuelve
a aplicarse la misma regla:

si la politica despierta a otro hilo,
A le transfiere el monitor (liberarMutex = false);

si no hay candidatas, A libera
el mutex normalmente (liberarMutex = true).
end note

Monitor --> HiloA : true
deactivate Monitor

@enduml
