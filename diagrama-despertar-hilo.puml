@startuml

title Despertar por politica y transferencia directa del monitor

skinparam backgroundColor white
skinparam ActorBorderColor #A80036
skinparam ActorFontColor black
skinparam ActorBackgroundColor #FEFECE
skinparam ParticipantBorderColor #A80036
skinparam ParticipantBackgroundColor white
skinparam ParticipantFontColor black
skinparam LifeLineBorderColor #A80036
skinparam LifeLineBackgroundColor #A80036
skinparam ArrowColor #A80036
skinparam ArrowFontColor black
skinparam SequenceGroupBorderColor #A80036
skinparam SequenceGroupBackgroundColor white
skinparam SequenceGroupFontColor black
skinparam NoteBackgroundColor #FBFB77
skinparam NoteBorderColor #A80036
skinparam NoteFontColor black

actor "hilo A : Hilo" as HiloA
actor "hilo B : Hilo" as HiloB

participant "monitor : Monitor" as Monitor
participant "mutex : Mutex" as Mutex
participant "colasTransiciones : ColasTransiciones" as Colas
participant "semaforoTi : Semaphore" as SemaforoTi
participant "redDePetri : RedDePetri" as Red
participant "politica : Politica" as Politica

== Hilo A intenta Ti y debe esperar ==

HiloA -> Monitor : fireTransition(Ti)
activate Monitor

Monitor -> Mutex : acquire()
activate Mutex
Mutex --> Monitor : permiso adquirido
deactivate Mutex

Monitor -> Red : simulacionFinalizada()
Red --> Monitor : false

Monitor -> Red : puedeDispararPorEstadoSimulacion(Ti)
Red --> Monitor : true

Monitor -> Colas : empezarEspera(Ti)

Monitor -> Red : puedeDisparar(Ti)
Red --> Monitor : false

Monitor -> Red : estaAntesDeLaVentanaTemporal(Ti)
Red --> Monitor : false

Monitor -> Colas : esperar(Ti)
activate Colas

Colas -> Colas : esperarEnSemaforo(Ti)

Colas -> Colas : controlColas.acquire()
Colas -> Colas : bloqueadosPorTransicion[Ti]++
Colas -> Colas : controlColas.release()

Colas -> Mutex : release()
activate Mutex
Mutex --> Colas : permiso liberado
deactivate Mutex

Colas -> SemaforoTi : acquire()
activate SemaforoTi

note right of SemaforoTi
El semaforo de Ti empieza con 0 permisos.
Por eso A queda bloqueado hasta que
alguien haga release() sobre esta cola.
end note

note right of Mutex
A NO conserva el mutex mientras espera.

Esto permite que otro hilo pueda
entrar al monitor y modificar el estado.
end note

deactivate Monitor

... A permanece bloqueado mientras otro hilo puede avanzar ...

== Hilo B entra y dispara Tj ==

HiloB -> Monitor : fireTransition(Tj)
activate Monitor

Monitor -> Mutex : acquire()
activate Mutex
Mutex --> Monitor : permiso adquirido
deactivate Mutex

Monitor -> Red : simulacionFinalizada()
Red --> Monitor : false

Monitor -> Red : puedeDispararPorEstadoSimulacion(Tj)
Red --> Monitor : true

Monitor -> Colas : empezarEspera(Tj)

Monitor -> Red : puedeDisparar(Tj)
Red --> Monitor : true

Monitor -> Colas : terminarEspera(Tj)

Monitor -> Red : disparar(Tj)
activate Red
Red --> Monitor : true
deactivate Red

== Politica selecciona Ti ==

Monitor -> Monitor : despertarTransicionElegidaPorPolitica()

Monitor -> Red : obtenerTransicionesDisparables()
Red --> Monitor : candidatas disparables

Monitor -> Colas : tieneHiloEsperando(Ti)
Colas --> Monitor : true

Monitor -> Red : puedeDispararPorEstadoSimulacion(Ti)
Red --> Monitor : true

Monitor -> Politica : elegirTransicion(candidatas)
activate Politica
Politica --> Monitor : Ti
deactivate Politica

Monitor -> Colas : despertar(Ti)
activate Colas

Colas -> Colas : controlColas.acquire()

Colas -> Colas : comprobar\npermisosPendientes[Ti] < bloqueados[Ti]

Colas -> Colas : permisosPendientesPorTransicion[Ti]++
Colas -> Colas : permisosHandoffPendientesPorTransicion[Ti]++

Colas -> SemaforoTi : release()

Colas -> Colas : controlColas.release()

Colas --> Monitor : true
deactivate Colas

note right of Colas
El permiso liberado queda marcado
tambien como permiso de HANDOFF.

No significa solamente:
"despertate".

Tambien significa:
"recibis el control logico del monitor".
end note

Monitor -> Monitor : liberarMutex = false

note right of Monitor
Como despertar(Ti) devolvio true,
el hilo B NO debe hacer mutex.release().
end note

Monitor --> HiloB : true
deactivate Monitor

== Hilo A consume el permiso de handoff ==

SemaforoTi --> Colas : acquire() retorna
deactivate SemaforoTi

activate Colas

Colas -> Colas : controlColas.acquire()

Colas -> Colas : bloqueadosPorTransicion[Ti]--

Colas -> Colas : permisosPendientesPorTransicion[Ti]--

alt permisosHandoffPendientesPorTransicion[Ti] > 0

    Colas -> Colas : permisosHandoffPendientesPorTransicion[Ti]--

    Colas -> Colas : mutexTransferido = true

else no habia promesa de handoff pendiente

    note right of Colas
    Este permiso vino de despertarTodos(),
    que nunca incrementa el contador de handoff.
    mutexTransferido se queda en false.
    end note

end

Colas -> Colas : controlColas.release()

alt mutexTransferido == true

    note right of Colas
    A NO ejecuta mutex.acquire().

    El monitor fue transferido
    directamente desde B hacia A.
    end note

else no era un permiso de handoff

    Colas -> Mutex : acquire()

end

Colas --> Monitor : retorna de esperar(Ti)
deactivate Colas

activate Monitor

== A vuelve al while de fireTransition(Ti) ==

Monitor -> Red : simulacionFinalizada()
Red --> Monitor : false

Monitor -> Red : puedeDispararPorEstadoSimulacion(Ti)
Red --> Monitor : true

Monitor -> Red : puedeDisparar(Ti)
Red --> Monitor : true

note right of Monitor
Despertar A NO dispara Ti automaticamente.

A vuelve al while y reevalua
todas las condiciones.
end note

Monitor -> Colas : terminarEspera(Ti)

Monitor -> Red : disparar(Ti)
activate Red
Red --> Monitor : true
deactivate Red

note right of Monitor
Despues del disparo de Ti vuelve
a aplicarse la misma regla:

si la politica despierta a otro hilo,
A le transfiere el monitor;

si no despierta a nadie,
A libera el mutex normalmente.
end note

Monitor --> HiloA : true
deactivate Monitor

@enduml