@startuml
title Reintento de un hilo luego de dormir en una cola de condición

actor "hilo A : Hilo" as HiloA
actor "hilo B : Hilo" as HiloB
participant "monitor : Monitor" as Monitor
participant "mutex : Mutex" as Mutex
participant "redDePetri : RedDePetri" as RedDePetri
participant "colasTransiciones : ColasTransiciones" as ColasTransiciones
participant "sensibilizadoConTiempo : SensibilizadoConTiempo" as Tiempo
participant "politica : Politica" as Politica
participant "estado : EstadoSimulacion" as Estado

HiloA -> Monitor : fireTransition(Ti)
activate Monitor

Monitor -> Mutex : acquire()
activate Mutex
Mutex --> Monitor : mutex adquirido
deactivate Mutex

Monitor -> Estado : estaFinalizada()
Estado --> Monitor : false
Monitor -> Estado : puedeDispararTransicion(Ti)
Estado --> Monitor : true
Monitor -> ColasTransiciones : empezarEspera(Ti)

Monitor -> RedDePetri : obtenerTransicionesSensibilizadas()
RedDePetri --> Monitor : sensibilizadas
Monitor -> Tiempo : actualizarSensibilizadas(sensibilizadas)
Monitor -> Monitor : actualizarTransicionSeleccionadaSiHaceFalta()
Monitor -> RedDePetri : estaSensibilizada(Ti)
RedDePetri --> Monitor : false

Monitor -> Monitor : despertarTransicionSeleccionada()
Monitor -> ColasTransiciones : esperar(Ti)

note right of ColasTransiciones
El hilo A duerme en la condición de Ti.
No queda consumiendo CPU.
Condition.await libera el mutex mientras
el hilo está dormido.
end note

... mientras A está dormido, otro hilo puede entrar al monitor ...

HiloB -> Monitor : fireTransition(Tj)
activate Monitor

Monitor -> Mutex : acquire()
activate Mutex
Mutex --> Monitor : mutex adquirido
deactivate Mutex

Monitor -> Estado : estaFinalizada()
Estado --> Monitor : false
Monitor -> Estado : puedeDispararTransicion(Tj)
Estado --> Monitor : true
Monitor -> ColasTransiciones : empezarEspera(Tj)

Monitor -> RedDePetri : obtenerTransicionesSensibilizadas()
RedDePetri --> Monitor : sensibilizadas
Monitor -> Tiempo : actualizarSensibilizadas(sensibilizadas)
Monitor -> Monitor : actualizarTransicionSeleccionadaSiHaceFalta()
Monitor -> Politica : elegirTransicion(candidatas)
Politica --> Monitor : Tj

Monitor -> ColasTransiciones : terminarEspera(Tj)
Monitor -> RedDePetri : disparar(Tj)
RedDePetri --> Monitor : disparada = true

note right of Monitor
El disparo de Tj modifica el marcado.
Con el nuevo marcado, Ti puede quedar
sensibilizada y pasar a ser candidata.
end note

Monitor -> RedDePetri : obtenerTransicionesSensibilizadas()
RedDePetri --> Monitor : nuevasSensibilizadas
Monitor -> Tiempo : actualizarSensibilizadas(nuevasSensibilizadas)
Monitor -> Estado : registrarTransicionDisparada(Tj)
Monitor -> Monitor : transicionSeleccionada = null
Monitor -> Monitor : despertarTransicionSeleccionada()
Monitor -> RedDePetri : obtenerTransicionesSensibilizadas()
RedDePetri --> Monitor : sensibilizadas
Monitor -> Tiempo : actualizarSensibilizadas(sensibilizadas)
Monitor -> ColasTransiciones : tieneHiloEsperando(Ti)
ColasTransiciones --> Monitor : true
Monitor -> Politica : elegirTransicion(candidatas)
Politica --> Monitor : Ti
Monitor -> ColasTransiciones : despertar(Ti)

Monitor -> Mutex : release()
Mutex --> Monitor : mutex liberado
deactivate Monitor

ColasTransiciones --> HiloA : señal sobre condición de Ti

note right of HiloA
La señal no ejecuta la transición por sí sola.
Solo permite que A despierte. Al volver
desde await, A recupera el mutex y sigue
en la misma llamada a fireTransition.
end note

HiloA -> Monitor : continúa dentro del while de fireTransition(Ti)

Monitor -> RedDePetri : obtenerTransicionesSensibilizadas()
RedDePetri --> Monitor : sensibilizadas
Monitor -> Tiempo : actualizarSensibilizadas(sensibilizadas)
Monitor -> Monitor : actualizarTransicionSeleccionadaSiHaceFalta()

alt transicionSeleccionada == Ti
    Monitor -> ColasTransiciones : terminarEspera(Ti)
    Monitor -> RedDePetri : disparar(Ti)
    RedDePetri --> Monitor : disparada = true
    Monitor -> Estado : registrarTransicionDisparada(Ti)
    Monitor -> Monitor : transicionSeleccionada = null
    Monitor -> Monitor : despertarTransicionSeleccionada()
    Monitor -> Mutex : release()
    Mutex --> Monitor : mutex liberado
    Monitor --> HiloA : true
else Ti ya no es candidata
    Monitor -> ColasTransiciones : esperar(Ti)
    note right of HiloA
    Aunque haya despertado, A vuelve
    a validar todo. Si Ti ya no puede
    avanzar, vuelve a dormir.
    end note
end

deactivate Monitor
@enduml
