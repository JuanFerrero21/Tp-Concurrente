@startuml
title Diagrama de clases - Simulador concurrente de Red de Petri

top to bottom direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam dpi 180

hide empty members

package "aplicacion" {
    class Main <<ejecutable>> {
        - NOMBRE_POLITICA : String
        - OBJETIVO_INVARIANTES_COMPLETOS : int
        - DETALLADO : boolean
        - RUTA_LOG : Path
        + main(args : String[]) : void
        - crearHilos(...) : Hilo[]
        - crearPolitica(nombrePolitica, config) : Politica
    }

    class Regex <<ejecutable>> {
        - RUTA_LOG : Path
        + main(args : String[]) : void
        - obtenerRutaLog(args : String[]) : Path
    }
}

package "configuracion" {
    class ConfiguracionSimulacion {
        - marcadoInicial : Marcado
        - matrizIncidencia : int[][]
        - transicionesHilos : int[][]
        - objetivoInvariantesCompletos : int
        - transicionIngreso : int
        - transicionFinalizacion : int
        - transicionesConflicto : int[]
        - transicionModoSimple : int
        - transicionesTemporales : boolean[]
        - alfaMillis : long[]
        - betaMillis : long[]
        + configuracionPorDefecto() : ConfiguracionSimulacion
        + configuracionPorDefecto(objetivo) : ConfiguracionSimulacion
        + configuracionPorDefecto(objetivo, perfilTemporal) : ConfiguracionSimulacion
        + obtenerMarcadoInicial() : Marcado
        + obtenerMatrizIncidencia() : int[][]
        + obtenerTransicionesHilos() : int[][]
        + obtenerCantidadHilos() : int
        + obtenerTransicionesConflicto() : int[]
        + obtenerTransicionModoSimple() : int
        + obtenerTransicionesTemporales() : boolean[]
        + obtenerAlfaMillis() : long[]
        + obtenerBetaMillis() : long[]
    }
}

package "hilo" {
    class Hilo extends Thread {
        - monitor : MonitorInterface
        - transicionesAsignadas : int[]
        - estadoSimulacion : EstadoSimulacion
        - registradorTransiciones : RegistradorTransiciones
        + Hilo(nombre, monitor, transiciones, estado, registrador)
        + run() : void
    }
}

package "monitor" {
    interface MonitorInterface {
        + fireTransition(transicion : int) : boolean
    }

    class Monitor {
        - redDePetri : RedDePetri
        - politica : Politica
        - mutex : Mutex
        - colasTransiciones : ColasTransiciones
        - detallado : boolean
        + Monitor(redDePetri, politica, detallado)
        + fireTransition(transicion : int) : boolean
        - esperarSegunEstadoTransicion(transicion : int) : void
        - despertarTransicionElegidaPorPolitica() : void
        - obtenerTransicionesSensibilizadasConHilosEsperando() : Set<Integer>
        - validarTransicion(transicion : int) : void
    }

    class Mutex {
        - semaforo : Semaphore
        - reingresosPreferentesPendientes : int
        + Mutex()
        + acquire() : void
        + adquirirComoPreferente() : void
        + registrarReingresoPreferente() : void
        + release() : void
    }

    class ColasTransiciones {
        - mutex : Mutex
        - semaforosPorTransicion : Semaphore[]
        - esperandoPorTransicion : int[]
        - bloqueadosPorTransicion : int[]
        - permisosPendientesPorTransicion : int[]
        + ColasTransiciones(mutex, cantidadTransiciones)
        + empezarEspera(transicion : int) : void
        + terminarEspera(transicion : int) : void
        + tieneHiloEsperando(transicion : int) : boolean
        + esperar(transicion : int) : void
        + esperarMillis(transicion : int, millis : long) : void
        + despertar(transicion : int) : void
        + despertarTodos() : void
    }
}

package "redpetri" {
    class RedDePetri {
        - marcado : Marcado
        - matrizIncidencia : int[][]
        - sensibilizadoConTiempo : SensibilizadoConTiempo
        - verificadorInvariantes : VerificadorInvariantes
        - estadoSimulacion : EstadoSimulacion
        - registradorTransiciones : RegistradorTransiciones
        + RedDePetri(marcadoInicial, matrizIncidencia)
        + configurarSemanticaTemporal(sensibilizadoConTiempo) : void
        + configurarVerificadorInvariantes(verificadorInvariantes) : void
        + configurarEstadoSimulacion(estadoSimulacion) : void
        + configurarRegistradorTransiciones(registradorTransiciones) : void
        + estaSensibilizada(transicion : int) : boolean
        + puedeDisparar(transicion : int) : boolean
        + disparar(transicion : int) : boolean
        + obtenerTransicionesSensibilizadas() : Set<Integer>
        + obtenerTransicionesDisparables() : Set<Integer>
        + obtenerMarcado() : Marcado
        + simulacionFinalizada() : boolean
        + puedeDispararPorEstadoSimulacion(transicion : int) : boolean
    }

    class Marcado {
        - tokens : int[]
        + Marcado(tokens : int[])
        + obtenerTokens(plaza : int) : int
        + sumar(valores : int[]) : Marcado
        + tieneTokensNegativos() : boolean
        + cantidad() : int
        + copia() : Marcado
        + obtenerTokensComoArreglo() : int[]
        + toString() : String
    }
}

package "tiempo" {
    class SensibilizadoConTiempo {
        - temporales : boolean[]
        - alfaMillis : long[]
        - betaMillis : long[]
        - timestampMillis : long[]
        - estabaSensibilizada : boolean[]
        - ventanaVencida : boolean[]
        + actualizarSensibilizadas(transicionesSensibilizadas : Set<Integer>) : void
        + puedeDispararAhora(transicion : int) : boolean
        + estaAntesDeLaVentana(transicion : int) : boolean
        + estaVencida(transicion : int) : boolean
        + milisegundosHastaAlfa(transicion : int) : long
        + describirEstado(transicion : int) : String
    }
}

package "politica" {
    interface Politica {
        + elegirTransicion(transicionesSensibilizadas : Set<Integer>) : int
    }

    class PoliticaAleatoria {
        - aleatorio : Random
        + PoliticaAleatoria()
        + elegirTransicion(transicionesSensibilizadas : Set<Integer>) : int
    }

    class PoliticaPrioridadSimple {
        - transicionModoSimple : Integer
        - aleatorio : Random
        + PoliticaPrioridadSimple(transicionModoSimple : int)
        + elegirTransicion(transicionesSensibilizadas : Set<Integer>) : int
    }
}

package "analisis" {
    class EstadoSimulacion {
        - objetivoInvariantesCompletos : int
        - transicionIngreso : int
        - transicionFinalizacion : int
        - transicionesInicioModo : int[]
        - completosPorModo : int[]
        - invariantesIniciados : int
        - invariantesCompletos : int
        + registrarTransicionDisparada(transicion : int) : void
        + estaFinalizada() : boolean
        + puedeDispararTransicion(transicion : int) : boolean
        + obtenerInvariantesCompletos() : int
        + obtenerInvariantesIniciados() : int
        + obtenerCompletosPorModo() : int[]
    }

    class VerificadorInvariantes {
        - invariantesPlaza : List<InvariantePlaza>
        + VerificadorInvariantes(marcadoInicial : Marcado)
        + seCumplenInvariantesPlaza(marcado : Marcado) : boolean
        + verificarInvariantesPlazaOLanzar(marcado : Marcado) : void
        + construirReporte(marcado : Marcado) : String
        + conservaTotalTokens(marcadoInicial, marcadoFinal) : boolean
    }

    class InvariantePlaza {
        - nombre : String
        - plazas : int[]
        - valorEsperado : int
        + seCumple(marcado : Marcado) : boolean
        + calcular(marcado : Marcado) : int
        + obtenerNombre() : String
        + obtenerValorEsperado() : int
    }

    class ResultadoSimulacion {
        - marcadoFinal : Marcado
        - intentosTotales : int
        - disparosTotales : int
        - disparosPorTransicion : int[]
        - invariantesPlazaCumplidos : boolean
        + obtenerMarcadoFinal() : Marcado
        + obtenerIntentosTotales() : int
        + obtenerDisparosTotales() : int
        + obtenerDisparosPorTransicion() : int[]
        + seCumplenInvariantesPlaza() : boolean
        + toString() : String
    }

    class AnalizadorRegexInvariantesTransicion {
        - PATRON_SIMPLE : Pattern
        - PATRON_MEDIO : Pattern
        - PATRON_ALTO : Pattern
        - PATRON_LINEA_DISPARO : Pattern
        - PATRON_INVARIANTE_COMPLETO : Pattern
        - PATRON_RESUMEN : Pattern
        + analizar(rutaLog : Path) : ResultadoAnalisisRegex
    }

    class ResultadoAnalisisRegex {
        - tokensAnalizados : int
        - cantidadMedio : int
        - cantidadSimple : int
        - cantidadAlto : int
        - cantidadInvalidos : int
        - cantidadIncompletos : int
        - analisisRegexValido : boolean
        - resumenValido : boolean
        - errores : List<String>
        + esAnalisisRegexValido() : boolean
        + construirReporte() : String
    }
}

package "registro" {
    class RegistradorTransiciones implements AutoCloseable {
        - intentosPorTransicion : int[]
        - disparosPorTransicion : int[]
        - escritor : PrintWriter
        - siguienteIdToken : int
        - modoPorIdToken : Map<Integer, String>
        + RegistradorTransiciones(cantidadTransiciones, rutaLog)
        + registrarIntento(transicion : int, disparada : boolean) : void
        + registrarEventoDisparo(transicion : int) : void
        + obtenerIntentosTotales() : int
        + obtenerDisparosTotales() : int
        + obtenerDisparosPorTransicion() : int[]
        + escribirResumen(...) : void
        + close() : void
    }
}

' Implementaciones de interfaces
Monitor ..|> MonitorInterface
PoliticaAleatoria ..|> Politica
PoliticaPrioridadSimple ..|> Politica

' Ejecucion principal
Main ..> ConfiguracionSimulacion : configura
Main ..> RedDePetri : crea
Main ..> Monitor : crea
Main ..> Hilo : inicia
Main ..> Politica : selecciona
Main ..> EstadoSimulacion : crea
Main ..> RegistradorTransiciones : crea
Main ..> VerificadorInvariantes : crea
Main ..> SensibilizadoConTiempo : crea

Regex ..> AnalizadorRegexInvariantesTransicion : ejecuta

' Monitor y sincronizacion
Hilo --> MonitorInterface : solicita fireTransition()
Hilo --> EstadoSimulacion : consulta finalizacion
Hilo --> RegistradorTransiciones : registra intentos

Monitor *-- Mutex : exclusion mutua
Monitor *-- ColasTransiciones : colas por transicion
Monitor --> RedDePetri : consulta/dispara
Monitor --> Politica : elige cola a despertar

ColasTransiciones --> Mutex : libera/reingresa
ColasTransiciones o-- "1..*" Semaphore : semaforos por transicion
Mutex o-- Semaphore : semaforo binario

' Red de Petri
RedDePetri *-- Marcado : marcado actual
RedDePetri --> SensibilizadoConTiempo : controla ventana temporal
RedDePetri --> VerificadorInvariantes : verifica invariantes de plaza
RedDePetri --> EstadoSimulacion : registra avance
RedDePetri --> RegistradorTransiciones : registra disparo/log

VerificadorInvariantes *-- "1..*" InvariantePlaza
ResultadoSimulacion --> Marcado : marcado final

' Analisis posterior
AnalizadorRegexInvariantesTransicion --> ResultadoAnalisisRegex : produce
AnalizadorRegexInvariantesTransicion ..> RegistradorTransiciones : valida log generado por

' Datos de configuracion
ConfiguracionSimulacion --> Marcado : marcado inicial

note right of Monitor
El unico metodo publico operativo es
fireTransition(int transicion).
El monitor coordina hilos, mutex,
colas y politica, pero no actualiza
el marcado directamente.
end note

note right of RedDePetri
La red encapsula el disparo real:
calcula nuevo marcado, verifica
invariantes de plaza, actualiza
timestamps temporales, registra
estado de simulacion y log.
end note

note bottom of ColasTransiciones
Cada transicion tiene un semaforo.
Si el monitor despierta una cola,
registra reingreso preferente para
que el hilo despertado recupere el mutex.
end note

@enduml
