@startuml

title Diagrama de clases - Simulador concurrente de Red de Petri

top to bottom direction

skinparam dpi 120
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 45
skinparam classAttributeIconSize 0
skinparam defaultFontName SansSerif
skinparam defaultFontSize 11

skinparam ArrowColor #4B5563
skinparam ArrowThickness 1

skinparam classBorderColor #9A3412
skinparam classBackgroundColor #FFF8D8
skinparam classHeaderBackgroundColor #FFF1B8
skinparam classFontColor #1F2937

skinparam noteBackgroundColor #FFFDF5
skinparam noteBorderColor #C9A227
skinparam noteFontColor #374151

skinparam interfaceBorderColor #1D4ED8
skinparam interfaceBackgroundColor #EAF2FF
skinparam interfaceFontColor #1E3A8A

hide empty members
hide circle

' ================================================================
' CLASES PRINCIPALES
' ================================================================

class Main <<ejecutable>> {
    {static} + main(args : String[]) : void
}

class ConfiguracionSimulacion {
    - marcadoInicial : Marcado
    - matrizIncidencia : int[][]
    - transicionesHilos : int[][]
    - transicionesConflicto : int[]
    - transicionModoSimple : int
    - transicionesTemporales, alfaMillis, betaMillis : [...]
    --
    + ConfiguracionSimulacion(...)
    {static} + configuracionPorDefecto(objetivo, perfil) : ConfiguracionSimulacion
    + obtenerXxx() : ...
    .. getters 1:1 por cada campo ..
}

class Hilo {
    - monitor : MonitorInterface
    - transicionesAsignadas : int[]
    - estadoSimulacion : EstadoSimulacion
    - registradorTransiciones : RegistradorTransiciones
    --
    + Hilo(nombre, monitor, transiciones, estado, registrador)
    + run() : void
}

interface MonitorInterface {
    + fireTransition(transicion : int) : boolean
}

class Monitor {
    - redDePetri : RedDePetri
    - politica : Politica
    - mutex : Mutex
    - colasTransiciones : ColasTransiciones
    - detallado : boolean
    --
    + Monitor(redDePetri, politica, detallado)
    + fireTransition(transicion : int) : boolean
    - esperarSegunEstadoTransicion(transicion : int) : void
    - despertarTransicionElegidaPorPolitica() : boolean
    - obtenerTransicionesSensibilizadasConHilosEsperando() : Set<Integer>
    - validarTransicion(transicion : int) : void
    - log(mensaje : String) : void
}

class Mutex {
    - semaforo : Semaphore
    --
    + Mutex()
    + acquire() : void
    + release() : void
}

class ColasTransiciones {
    - mutex : Mutex
    - colas : Semaphore[]
    - esperando : int[]
    - finalizando : boolean
    --
    + ColasTransiciones(mutex, cantidadTransiciones)
    + obtenerCantidadTransiciones() : int
    + tieneHiloEsperando(transicion : int) : boolean
    + esperar(transicion : int) : void
    + esperarMillis(millis : long) : void
    + despertar(transicion : int) : boolean
    + despertarTodos() : void
}

interface Politica {
    + elegirTransicion(candidatas : Set<Integer>) : int
    {static} + elegirAlAzar(candidatas : Set<Integer>, aleatorio : Random) : int
}

class PoliticaAleatoria {
    - aleatorio : Random
    --
    + PoliticaAleatoria()
    + elegirTransicion(candidatas : Set<Integer>) : int
}

class PoliticaPrioridadSimple {
    - transicionModoSimple : Integer
    - aleatorio : Random
    --
    + PoliticaPrioridadSimple(transicionModoSimple : int)
    + elegirTransicion(candidatas : Set<Integer>) : int
}

class RedDePetri {
    - marcado : Marcado
    - matrizIncidencia : int[][]
    - sensibilizadoConTiempo : SensibilizadoConTiempo
    - verificadorInvariantes : VerificadorInvariantes
    - estadoSimulacion : EstadoSimulacion
    - registradorTransiciones : RegistradorTransiciones
    --
    + RedDePetri(marcadoInicial, matrizIncidencia)
    + configurarSemanticaTemporal(tiempo) : void
    + configurarVerificadorInvariantes(verificador) : void
    + configurarEstadoSimulacion(estado) : void
    + configurarRegistradorTransiciones(registrador) : void
    + estaSensibilizada(transicion : int) : boolean
    + puedeDisparar(transicion : int) : boolean
    + disparar(transicion : int) : boolean
    + estaAntesDeLaVentanaTemporal(transicion : int) : boolean
    + milisegundosHastaVentanaTemporal(transicion : int) : long
    + esCandidataParaDespertar(transicion : int) : boolean
    + describirMotivoEspera(transicion : int) : String
    + obtenerTransicionesSensibilizadas() : Set<Integer>
    + obtenerTransicionesDisparables() : Set<Integer>
    + obtenerMarcado() : Marcado
    + obtenerCantidadPlazas() : int
    + obtenerCantidadTransiciones() : int
    + seCumplenInvariantesPlaza() : boolean
    + construirReporteInvariantesPlaza() : String
    + simulacionFinalizada() : boolean
    + puedeDispararPorEstadoSimulacion(transicion : int) : boolean
}

class Marcado {
    - tokens : int[]
    --
    + Marcado(tokens : int[])
    + obtenerTokens(plaza : int) : int
    + sumar(valores : int[]) : Marcado
    + tieneTokensNegativos() : boolean
    + cantidad() : int
    + copia() : Marcado
    + toString() : String
}

class SensibilizadoConTiempo {
    {static} - SIN_TIMESTAMP : long
    - temporales : boolean[]
    - alfaMillis : long[]
    - betaMillis : long[]
    - timestampMillis : long[]
    - estabaSensibilizada : boolean[]
    - ventanaVencida : boolean[]
    --
    + SensibilizadoConTiempo(temporales, alfaMillis, betaMillis)
    + actualizarSensibilizadas(sensibilizadas : Set<Integer>) : void
    + puedeDispararAhora(transicion : int) : boolean
    + estaAntesDeLaVentana(transicion : int) : boolean
    + estaVencida(transicion : int) : boolean
    + milisegundosHastaAlfa(transicion : int) : long
    + esTemporal(transicion : int) : boolean
    + describirEstado(transicion : int) : String
}

class EstadoSimulacion {
    - objetivoInvariantesCompletos : int
    - transicionIngreso : int
    - transicionFinalizacion : int
    - transicionesInicioModo : int[]
    - completosPorModo : int[]
    - invariantesIniciados : int
    - invariantesCompletos : int
    --
    + EstadoSimulacion(objetivo, ingreso, finalizacion, iniciosModo)
    + registrarTransicionDisparada(transicion : int) : void
    + estaFinalizada() : boolean
    + puedeDispararTransicion(transicion : int) : boolean
    + obtenerInvariantesCompletos() : int
    + obtenerInvariantesIniciados() : int
    + obtenerObjetivoInvariantesCompletos() : int
    + obtenerCompletosPorModo() : int[]
}

class VerificadorInvariantes {
    - invariantesPlaza : List<InvariantePlaza>
    --
    + VerificadorInvariantes(marcadoInicial : Marcado)
    + seCumplenInvariantesPlaza(marcado : Marcado) : boolean
    + verificarInvariantesPlazaOLanzar(marcado : Marcado) : void
    + construirReporte(marcado : Marcado) : String
}

class InvariantePlaza <<clase interna>> {
    - nombre : String
    - plazas : int[]
    - valorEsperado : int
    --
    + InvariantePlaza(nombre, plazas, valorEsperado)
    {static} + desdeMarcadoInicial(nombre, plazas, marcado) : InvariantePlaza
    + seCumple(marcado : Marcado) : boolean
    + calcular(marcado : Marcado) : int
    + obtenerNombre() : String
    + obtenerPlazas() : int[]
    + obtenerValorEsperado() : int
}

class RegistradorTransiciones {
    - intentosPorTransicion, disparosPorTransicion : int[]
    - escritor : PrintWriter
    - colas por plaza (p1..p11Tokens) : Deque<Integer>
    - modoPorIdToken : Map<Integer, String>
    --
    + RegistradorTransiciones(cantidad, ruta, politica, objetivo, temporales, alfa, beta)
    + registrarIntento(transicion : int, disparada : boolean) : void
    + registrarEventoDisparo(transicion : int) : void
    + obtenerIntentosTotales() : int
    + obtenerDisparosTotales() : int
    + obtenerDisparosPorTransicion() : int[]
    + escribirResumen(...) : void
    + close() : void
}

class ResultadoSimulacion {
    - marcadoFinal : Marcado
    - intentosTotales : int
    - disparosTotales : int
    - disparosPorTransicion : int[]
    - invariantesPlazaCumplidos : boolean
    --
    + ResultadoSimulacion(...)
    + obtenerMarcadoFinal() : Marcado
    + obtenerIntentosTotales() : int
    + obtenerDisparosTotales() : int
    + obtenerDisparosPorTransicion() : int[]
    + seCumplenInvariantesPlaza() : boolean
    + toString() : String
}

' ================================================================
' ANALISIS REGEX
' ================================================================

class Regex <<ejecutable independiente>> {
    {static} - RUTA_LOG : Path
    --
    {static} + main(args : String[]) : void
    {static} - obtenerRutaLog(args : String[]) : Path
}

class AnalizadorRegexInvariantesTransicion {
    {static} - PATRON_* (6 regex) : Pattern
    --
    + analizar(rutaLog : Path) : ResultadoAnalisisRegex
}

class ResultadoAnalisisRegex <<clase interna>> {
    - tokensAnalizados : int
    - cantidadMedio : int
    - cantidadSimple : int
    - cantidadAlto : int
    - cantidadInvalidos : int
    - cantidadIncompletos : int
    - analisisRegexValido : boolean
    - resumenValido : boolean
    - lineaResumen : LineaResumen
    - errores : List<String>
    --
    + esAnalisisRegexValido() : boolean
    + construirReporte() : String
}

class Thread <<Java>> #F3F4F6
class Semaphore <<Java>> #F3F4F6
interface AutoCloseable <<Java>> #F3F4F6

' ================================================================
' HERENCIA / IMPLEMENTACION
' ================================================================

Hilo --|> Thread

Monitor ..|> MonitorInterface

PoliticaAleatoria ..|> Politica
PoliticaPrioridadSimple ..|> Politica

RegistradorTransiciones ..|> AutoCloseable

' ================================================================
' RELACIONES DEL NUCLEO
' ================================================================

Hilo --> MonitorInterface : solicita disparos
Hilo --> EstadoSimulacion : consulta finalizacion
Hilo --> RegistradorTransiciones : registra intentos

Monitor *-- Mutex : crea y controla
Monitor *-- ColasTransiciones : crea y controla
Monitor --> RedDePetri : consulta y dispara
Monitor --> Politica : selecciona candidata

ColasTransiciones --> Mutex : libera/readquiere
ColasTransiciones *-- "1..*" Semaphore : una cola por transicion
Mutex *-- "1" Semaphore : exclusion mutua

RedDePetri *-- Marcado : marcado actual
RedDePetri --> SensibilizadoConTiempo : semantica temporal
RedDePetri --> VerificadorInvariantes : verifica invariantes
RedDePetri --> EstadoSimulacion : actualiza avance
RedDePetri --> RegistradorTransiciones : registra disparos

VerificadorInvariantes *-- "3" InvariantePlaza : invariantes de plaza

ConfiguracionSimulacion *-- Marcado : marcado inicial

ResultadoSimulacion *-- Marcado : marcado final

' ================================================================
' DEPENDENCIAS DE MAIN
' ================================================================

Main ..> ConfiguracionSimulacion : obtiene configuracion
Main ..> RedDePetri : crea
Main ..> EstadoSimulacion : crea
Main ..> SensibilizadoConTiempo : crea
Main ..> RegistradorTransiciones : crea
Main ..> VerificadorInvariantes : crea
Main ..> Politica : usa
Main ..> PoliticaAleatoria : puede crear
Main ..> PoliticaPrioridadSimple : puede crear
Main ..> Monitor : crea
Main ..> MonitorInterface : usa
Main ..> Hilo : crea e inicia
Main ..> ResultadoSimulacion : crea

' ================================================================
' REGEX
' ================================================================

Regex ..> AnalizadorRegexInvariantesTransicion : crea y ejecuta
Regex ..> ResultadoAnalisisRegex : consulta
AnalizadorRegexInvariantesTransicion ..> ResultadoAnalisisRegex : crea

' ================================================================
' ORDEN VISUAL
' ================================================================

Main -[hidden]right-> ConfiguracionSimulacion
ConfiguracionSimulacion -[hidden]right-> ResultadoSimulacion

Hilo -[hidden]right-> MonitorInterface
MonitorInterface -[hidden]right-> Monitor
Monitor -[hidden]right-> Politica
Politica -[hidden]right-> RedDePetri

Thread -[hidden]right-> Mutex
Mutex -[hidden]right-> ColasTransiciones
ColasTransiciones -[hidden]right-> PoliticaAleatoria
PoliticaAleatoria -[hidden]right-> PoliticaPrioridadSimple
PoliticaPrioridadSimple -[hidden]right-> Marcado

EstadoSimulacion -[hidden]right-> RegistradorTransiciones
RegistradorTransiciones -[hidden]right-> VerificadorInvariantes
VerificadorInvariantes -[hidden]right-> SensibilizadoConTiempo

Main -[hidden]down-> Hilo
Hilo -[hidden]down-> Thread
Thread -[hidden]down-> EstadoSimulacion
EstadoSimulacion -[hidden]down-> Regex

ConfiguracionSimulacion -[hidden]down-> MonitorInterface
MonitorInterface -[hidden]down-> ColasTransiciones
ColasTransiciones -[hidden]down-> RegistradorTransiciones
RegistradorTransiciones -[hidden]down-> AnalizadorRegexInvariantesTransicion

ResultadoSimulacion -[hidden]down-> Monitor
Monitor -[hidden]down-> PoliticaAleatoria
PoliticaAleatoria -[hidden]down-> VerificadorInvariantes
VerificadorInvariantes -[hidden]down-> ResultadoAnalisisRegex

RedDePetri -[hidden]down-> Marcado
Marcado -[hidden]down-> SensibilizadoConTiempo

note left of Monitor
Unico metodo publico operativo:
fireTransition(int).

Coordina:
- exclusion mutua
- esperas
- colas
- politica
- transferencia del monitor
end note

note bottom of Mutex
Usa Semaphore(1, true).

Al no tener ownership estricto,
permite que un hilo haga acquire()
y otro hilo libere posteriormente
el permiso luego de un handoff.
end note

note bottom of ColasTransiciones
Cada transicion posee su semaforo de condicion.

Si despertar(Ti) entrega handoff,
el hilo despertado continua sin hacer mutex.acquire().

Si no hay handoff, el hilo readquiere
el mutex normalmente.
end note

@enduml