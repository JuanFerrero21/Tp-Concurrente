@startuml
title Disparo exitoso con monitor, semaforos y politica posterior al disparo

skinparam backgroundColor white
skinparam ActorBorderColor #A80036
skinparam ActorFontColor black
skinparam ActorBackgroundColor #FEFECE
skinparam ParticipantBorderColor #A80036
skinparam ParticipantBackgroundColor white
skinparam ParticipantFontColor black
skinparam LifeLineBorderColor #A80036
skinparam LifeLineBackgroundColor #A80036
skinparam ArrowColor #A80036
skinparam ArrowFontColor black
skinparam SequenceGroupBorderColor #A80036
skinparam SequenceGroupBackgroundColor white
skinparam SequenceGroupFontColor black
skinparam NoteBackgroundColor #FBFB77
skinparam NoteBorderColor #A80036
skinparam NoteFontColor black

actor "hilo : Hilo" as Hilo

participant "monitor : Monitor" as Monitor
participant "mutex : Mutex" as Mutex
participant "redDePetri : RedDePetri" as RedDePetri
participant "colasTransiciones : ColasTransiciones" as ColasTransiciones
participant "politica : Politica" as Politica
participant "verificador : VerificadorInvariantes" as Verificador
participant "estadoSimulacion : EstadoSimulacion" as Estado
participant "registrador : RegistradorTransiciones" as Registrador

Hilo -> Monitor : fireTransition(Ti)
activate Monitor

Monitor -> Mutex : acquire()
activate Mutex
Mutex --> Monitor : mutex adquirido
deactivate Mutex

note right of Monitor
El monitor toma el mutex para que
solo un hilo por vez pueda decidir
si espera, dispara o despierta a otro.
end note

Monitor -> Monitor : validarTransicion(Ti)
Monitor -> RedDePetri : simulacionFinalizada()
RedDePetri --> Monitor : false
Monitor -> RedDePetri : puedeDispararPorEstadoSimulacion(Ti)
RedDePetri --> Monitor : true

alt simulacion finalizada o Ti ya no puede iniciar ciclos
    Monitor -> Mutex : release()
    activate Mutex
    Mutex --> Monitor : mutex liberado
    deactivate Mutex
    Monitor --> Hilo : false
else puede intentar disparar
    Monitor -> ColasTransiciones : empezarEspera(Ti)

    loop hasta que Ti pueda dispararse o finalice la simulacion
        Monitor -> RedDePetri : simulacionFinalizada()
        RedDePetri --> Monitor : false
        Monitor -> RedDePetri : puedeDispararPorEstadoSimulacion(Ti)
        RedDePetri --> Monitor : true

        alt finalizo o Ti ya no puede dispararse por estado
            Monitor -> ColasTransiciones : terminarEspera(Ti)
            Monitor -> ColasTransiciones : despertarTodos()
            Monitor -> Mutex : release()
            activate Mutex
            Mutex --> Monitor : mutex liberado
            deactivate Mutex
            Monitor --> Hilo : false
        else la simulacion sigue
            Monitor -> RedDePetri : puedeDisparar(Ti)
            RedDePetri --> Monitor : true/false

            note right of RedDePetri
            Chequea tokens, estado de la simulacion
            y ventana temporal. No cambia el marcado
            ni actualiza ningun timestamp.
            end note

            alt Ti todavia no puede dispararse
                Monitor -> ColasTransiciones : esperar(Ti) / esperarMillis(Ti, ms)
                note right of ColasTransiciones
                El hilo se bloquea en la cola de Ti,
                soltando el mutex mientras espera, y
                reingresa (con o sin prioridad) al ser
                despertado. Detalle completo en el
                diagrama "Reintento de un hilo
                despertado por la politica".
                end note
            end
        end
    end

    Monitor -> ColasTransiciones : terminarEspera(Ti)

    Monitor -> RedDePetri : disparar(Ti)
    activate RedDePetri

    note right of RedDePetri
    Cambia el marcado, verifica invariantes de
    plaza, actualiza ventanas temporales y
    registra el disparo.
    end note

    RedDePetri -> Verificador : verificarInvariantesPlazaOLanzar(marcado)
    Verificador --> RedDePetri : ok
    RedDePetri -> Estado : registrarTransicionDisparada(Ti)
    Estado --> RedDePetri : ok
    RedDePetri -> Registrador : registrarEventoDisparo(Ti)
    Registrador --> RedDePetri : log actualizado

    RedDePetri --> Monitor : true
    deactivate RedDePetri

    Monitor -> RedDePetri : simulacionFinalizada()
    RedDePetri --> Monitor : true/false

    alt simulacion finalizada
        Monitor -> ColasTransiciones : despertarTodos()
        note right of ColasTransiciones
        Se liberan los hilos bloqueados para
        que puedan salir limpiamente.
        end note
    else continua la simulacion
        Monitor -> Monitor : despertarTransicionElegidaPorPolitica()
        activate Monitor

        Monitor -> RedDePetri : obtenerTransicionesDisparables()
        RedDePetri --> Monitor : disparables

        loop por cada transicion disparable
            Monitor -> ColasTransiciones : tieneHiloEsperando(Tj)
            ColasTransiciones --> Monitor : true/false
            Monitor -> RedDePetri : puedeDispararPorEstadoSimulacion(Tj)
            RedDePetri --> Monitor : true/false
        end

        alt hay candidatas
            Monitor -> Politica : elegirTransicion(candidatas)
            activate Politica
            Politica --> Monitor : Tj
            deactivate Politica

            note right of Politica
            La politica solo se consulta despues
            de un disparo exitoso, porque recien
            ahi cambio el marcado.
            end note

            Monitor -> ColasTransiciones : despertar(Tj)
            note right of ColasTransiciones
            Solo libera un permiso si hay
            realmente un hilo bloqueado sin
            permiso ya prometido.
            end note
        else no hay candidatas
            note right of Monitor
            Nadie esta esperando una transicion
            disparable: no se despierta ninguna cola.
            end note
        end

        deactivate Monitor
    end

    Monitor -> Mutex : release()
    activate Mutex
    Mutex --> Monitor : mutex liberado
    deactivate Mutex
    Monitor --> Hilo : true
end

deactivate Monitor

@enduml
