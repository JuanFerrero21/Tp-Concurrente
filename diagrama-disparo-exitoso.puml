@startuml
title Flujo real del monitor para fireTransition(Ti)

actor "hilo : Hilo" as Hilo
participant "monitor : Monitor" as Monitor
participant "mutex : Mutex" as Mutex
participant "redDePetri : RedDePetri" as RedDePetri
participant "colasTransiciones : ColasTransiciones" as ColasTransiciones
participant "sensibilizadoConTiempo : SensibilizadoConTiempo" as Tiempo
participant "politica : Politica" as Politica
participant "estado : EstadoSimulacion" as Estado
participant "verificador : VerificadorInvariantes" as Verificador

Hilo -> Monitor : fireTransition(Ti)
activate Monitor

Monitor -> Mutex : acquire()
activate Mutex
Mutex --> Monitor : mutex adquirido
deactivate Mutex

note right of Monitor
Desde este punto el hilo está dentro
de la sección crítica del monitor.
El mutex se libera en el finally.
Cuando el hilo espera en una Condition,
await libera temporalmente el mutex y
lo recupera antes de continuar.
end note

Monitor -> Estado : estaFinalizada()
Estado --> Monitor : true/false
Monitor -> Estado : puedeDispararTransicion(Ti)
Estado --> Monitor : true/false

alt simulación finalizada o Ti no puede iniciar más ciclos
    Monitor --> Hilo : false
else puede continuar
    Monitor -> ColasTransiciones : empezarEspera(Ti)
    note right of ColasTransiciones
    El hilo queda contado como interesado
    en Ti. Todavía no necesariamente duerme.
    Esto permite que el monitor arme
    candidatas con hilos esperando.
    end note

    loop hasta que Ti sea seleccionada o finalice la simulación
        Monitor -> Estado : estaFinalizada()
        Estado --> Monitor : true/false
        Monitor -> Estado : puedeDispararTransicion(Ti)
        Estado --> Monitor : true/false

        alt finalizó o Ti ya no puede dispararse por estado
            Monitor -> ColasTransiciones : terminarEspera(Ti)
            Monitor -> Monitor : transicionSeleccionada = null
            Monitor -> ColasTransiciones : despertarTodos()
            Monitor --> Hilo : false
        else la simulación sigue
            Monitor -> RedDePetri : obtenerTransicionesSensibilizadas()
            activate RedDePetri
            RedDePetri --> Monitor : sensibilizadas
            deactivate RedDePetri

            Monitor -> Tiempo : actualizarSensibilizadas(sensibilizadas)

            Monitor -> Monitor : actualizarTransicionSeleccionadaSiHaceFalta()
            activate Monitor
            Monitor -> RedDePetri : obtenerTransicionesSensibilizadas()
            RedDePetri --> Monitor : sensibilizadas
            Monitor -> Tiempo : actualizarSensibilizadas(sensibilizadas)
            Monitor -> ColasTransiciones : tieneHiloEsperando(Tx)
            ColasTransiciones --> Monitor : true/false
            Monitor -> Estado : puedeDispararTransicion(Tx)
            Estado --> Monitor : true/false
            Monitor -> Tiempo : puedeDispararAhora(Tx)
            Tiempo --> Monitor : true/false

            alt hay candidatas y hace falta elegir
                Monitor -> Politica : elegirTransicion(candidatas)
                Politica --> Monitor : transicionSeleccionada
            else no hay candidatas
                Monitor -> Monitor : transicionSeleccionada = null
            end
            deactivate Monitor

            alt transicionSeleccionada == Ti
                note right of Monitor
                Ti fue elegida por la política.
                Se sale del while para disparar.
                end note
                break Ti seleccionada
            else Ti no fue seleccionada todavía
                Monitor -> RedDePetri : estaSensibilizada(Ti)
                RedDePetri --> Monitor : true/false

                alt Ti no está sensibilizada por tokens
                    Monitor -> Monitor : despertarTransicionSeleccionada()
                    Monitor -> ColasTransiciones : despertar(transicionSeleccionada)
                    Monitor -> ColasTransiciones : esperar(Ti)
                    note right of ColasTransiciones
                    Condition.await duerme al hilo.
                    Mientras duerme libera el mutex.
                    Al despertar, vuelve con el mutex
                    tomado y reintenta el while.
                    end note
                else Ti está sensibilizada
                    Monitor -> Tiempo : puedeDispararAhora(Ti)
                    Tiempo --> Monitor : true/false

                    alt Ti no cumple ventana temporal
                        Monitor -> Monitor : esperarPorVentanaTemporal(Ti)
                        activate Monitor
                        Monitor -> Tiempo : estaAntesDeLaVentana(Ti)
                        Tiempo --> Monitor : true/false

                        alt antes de alfa
                            Monitor -> Tiempo : milisegundosHastaAlfa(Ti)
                            Tiempo --> Monitor : millisHastaAlfa
                            Monitor -> Monitor : despertarTransicionSeleccionada()
                            Monitor -> ColasTransiciones : despertar(transicionSeleccionada)
                            Monitor -> ColasTransiciones : esperarMillis(Ti, millisHastaAlfa)
                        else vencida o sin ventana válida
                            Monitor -> Tiempo : estaVencida(Ti)
                            Tiempo --> Monitor : true/false
                            Monitor -> Monitor : despertarTransicionSeleccionada()
                            Monitor -> ColasTransiciones : despertar(transicionSeleccionada)
                            Monitor -> ColasTransiciones : esperar(Ti)
                        end
                        deactivate Monitor
                    else Ti cumple tokens y tiempo, pero la política eligió otra
                        Monitor -> Monitor : despertarTransicionSeleccionada()
                        Monitor -> ColasTransiciones : despertar(transicionSeleccionada)
                        Monitor -> ColasTransiciones : esperar(Ti)
                    end
                end

                note right of Hilo
                Cuando el hilo despierta no asume
                que Ti ya puede dispararse. Sigue
                dentro del mismo fireTransition y
                vuelve a evaluar estado, tokens,
                tiempo y política.
                end note
            end
        end
    end

    Monitor -> ColasTransiciones : terminarEspera(Ti)
    Monitor -> RedDePetri : disparar(Ti)
    activate RedDePetri
    RedDePetri --> Monitor : disparada = true
    deactivate RedDePetri

    Monitor -> Verificador : verificarInvariantesPlazaOLanzar(marcadoActual)
    Monitor -> RedDePetri : obtenerTransicionesSensibilizadas()
    RedDePetri --> Monitor : sensibilizadas
    Monitor -> Tiempo : actualizarSensibilizadas(sensibilizadas)
    Monitor -> Estado : registrarTransicionDisparada(Ti)

    Monitor -> Monitor : transicionSeleccionada = null
    Monitor -> Estado : estaFinalizada()
    Estado --> Monitor : true/false

    alt simulación finalizada
        Monitor -> ColasTransiciones : despertarTodos()
    else continúa la simulación
        Monitor -> Monitor : despertarTransicionSeleccionada()
        Monitor -> ColasTransiciones : despertar(transicionSeleccionada)
    end

    Monitor --> Hilo : true
end

Monitor -> Mutex : release()
activate Mutex
Mutex --> Monitor : mutex liberado
deactivate Mutex

deactivate Monitor
@enduml
