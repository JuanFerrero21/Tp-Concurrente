@startuml

title Disparo exitoso con monitor, tiempo, colas y politica

skinparam backgroundColor white
skinparam ActorBorderColor #A80036
skinparam ActorFontColor black
skinparam ActorBackgroundColor #FEFECE
skinparam ParticipantBorderColor #A80036
skinparam ParticipantBackgroundColor white
skinparam ParticipantFontColor black
skinparam LifeLineBorderColor #A80036
skinparam LifeLineBackgroundColor #A80036
skinparam ArrowColor #A80036
skinparam ArrowFontColor black
skinparam SequenceGroupBorderColor #A80036
skinparam SequenceGroupBackgroundColor white
skinparam SequenceGroupFontColor black
skinparam NoteBackgroundColor #FBFB77
skinparam NoteBorderColor #A80036
skinparam NoteFontColor black

actor "hilo : Hilo" as Hilo

participant "monitor : Monitor" as Monitor
participant "mutex : Mutex" as Mutex
participant "redDePetri : RedDePetri" as Red
participant "colasTransiciones : ColasTransiciones" as Colas
participant "politica : Politica" as Politica
participant "verificador : VerificadorInvariantes" as Verificador
participant "estadoSimulacion : EstadoSimulacion" as Estado
participant "registrador : RegistradorTransiciones" as Registrador

Hilo -> Monitor : fireTransition(Ti)
activate Monitor

Monitor -> Mutex : acquire()
activate Mutex
Mutex --> Monitor : permiso adquirido
deactivate Mutex

Monitor -> Monitor : liberarMutex = true
Monitor -> Monitor : validarTransicion(Ti)

note right of Mutex
El mutex es un Semaphore(1, true).
Mientras su permiso esta tomado,
solo un hilo controla el monitor.
end note

Monitor -> Red : simulacionFinalizada()
Red --> Monitor : false

Monitor -> Red : puedeDispararPorEstadoSimulacion(Ti)
Red --> Monitor : true

Monitor -> Colas : empezarEspera(Ti)

loop hasta que Ti pueda dispararse

    Monitor -> Red : simulacionFinalizada()
    Red --> Monitor : false

    Monitor -> Red : puedeDispararPorEstadoSimulacion(Ti)
    Red --> Monitor : true

    Monitor -> Red : puedeDisparar(Ti)
    Red --> Monitor : true / false

    note right of Red
    puedeDisparar(Ti) exige:
    - estado de simulacion permitido
    - sensibilizacion por tokens
    - restriccion temporal valida
    end note

    alt Ti puede dispararse

        note right of Monitor
        Se abandona el while
        y se realiza el disparo.
        end note

    else Ti todavia no puede dispararse

        Monitor -> Monitor : esperarSegunEstadoTransicion(Ti)

        Monitor -> Red : estaAntesDeLaVentanaTemporal(Ti)
        Red --> Monitor : true / false

        alt Ti esta antes de alfa

            Monitor -> Red : milisegundosHastaVentanaTemporal(Ti)
            Red --> Monitor : ms restantes

            Monitor -> Colas : esperarMillis(Ti, ms)
            activate Colas

            Colas -> Mutex : release()
            activate Mutex
            Mutex --> Colas : permiso liberado
            deactivate Mutex

            Colas -> Colas : Thread.sleep(ms)

            Colas -> Mutex : acquire()
            activate Mutex
            Mutex --> Colas : permiso readquirido
            deactivate Mutex

            Colas --> Monitor : retorna
            deactivate Colas

            note right of Colas
            Esperar por alfa NO es un handoff.

            El hilo libera el monitor,
            duerme hasta alfa y luego
            vuelve a competir por el mutex.
            end note

        else no esta antes de alfa

            Monitor -> Colas : esperar(Ti)
            activate Colas

            note right of Colas
            El hilo queda bloqueado en el
            semaforo asociado a Ti.

            Antes de bloquearse libera el mutex.
            end note

            Colas --> Monitor : retorna al ser despertado
            deactivate Colas

        end
    end
end

Monitor -> Colas : terminarEspera(Ti)

== Disparo real ==

Monitor -> Red : disparar(Ti)
activate Red

Red -> Red : calcularSiguienteMarcado(Ti)
Red -> Red : marcado = nuevoMarcado

note right of Red
La Red de Petri aplica la ecuacion de estado:
M' = M + columna(Ti)
end note

Red -> Verificador : verificarInvariantesPlazaOLanzar(marcado)
activate Verificador
Verificador --> Red : invariantes OK
deactivate Verificador

Red -> Red : actualizarSensibilizadasTemporales()

Red -> Estado : registrarTransicionDisparada(Ti)
activate Estado
Estado --> Red : estado actualizado
deactivate Estado

Red -> Registrador : registrarEventoDisparo(Ti)
activate Registrador
Registrador --> Red : log actualizado
deactivate Registrador

Red --> Monitor : true
deactivate Red

== Decision de quien continua ==

Monitor -> Red : simulacionFinalizada()
Red --> Monitor : true / false

alt simulacion finalizada

    Monitor -> Colas : despertarTodos()

    note right of Colas
    Se despiertan todos para que
    puedan observar la finalizacion.

    despertarTodos() NO entrega handoff.
    end note

else simulacion continua

    Monitor -> Monitor : despertarTransicionElegidaPorPolitica()

    Monitor -> Red : obtenerTransicionesDisparables()
    Red --> Monitor : transiciones disparables

    loop por cada transicion disparable Tj

        Monitor -> Colas : tieneHiloEsperando(Tj)
        Colas --> Monitor : true / false

        Monitor -> Red : puedeDispararPorEstadoSimulacion(Tj)
        Red --> Monitor : true / false

    end

    alt hay candidatas

        Monitor -> Politica : elegirTransicion(candidatas)
        activate Politica
        Politica --> Monitor : Tj
        deactivate Politica

        Monitor -> Colas : despertar(Tj)
        Colas --> Monitor : true / false

        alt despertar(Tj) == true

            Monitor -> Monitor : liberarMutex = false

            note right of Monitor
            Hubo handoff.

            El hilo actual NO libera el mutex.
            El hilo despertado recibe
            directamente el control del monitor.
            end note

        else despertar(Tj) == false

            Monitor -> Monitor : liberarMutex = true

            note right of Monitor
            No habia un hilo bloqueado disponible
            al cual transferir el monitor.
            end note

        end

    else no hay candidatas

        Monitor -> Monitor : liberarMutex = true

    end
end

== Salida de fireTransition ==

alt liberarMutex == true

    Monitor -> Mutex : release() [finally]
    activate Mutex
    Mutex --> Monitor : permiso liberado
    deactivate Mutex

else liberarMutex == false

    note right of Monitor
    No se ejecuta mutex.release().

    El permiso sigue tomado y su
    responsabilidad logica pasa
    al hilo despertado.
    end note

end

Monitor --> Hilo : true
deactivate Monitor

@enduml